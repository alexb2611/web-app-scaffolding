# ===========================================================================
# Environment Configuration
# ===========================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
APP_NAME=myapp
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh-token cookie. COOKIE_SECURE auto-enables when ENVIRONMENT=production;
# uncomment to force on/off (e.g. behind a TLS-terminating proxy in staging).
# COOKIE_SAMESITE: lax | strict | none.
# COOKIE_SECURE=
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# Rate limiting on auth endpoints (5/min on register, 10/min on login).
# Leave true for development and production; set to false for E2E suites
# and load tests, where the throttling would cause spurious failures.
RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myapp
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Observability (opt-in — leave blank to disable)
# ---------------------------------------------------------------------------
# OpenTelemetry — backend traces ship to any OTLP/HTTP-compatible collector
# (Tempo, Jaeger, Honeycomb, Datadog, etc). For local dev, set
# OTEL_CONSOLE_EXPORTER=true to print spans to stdout without a collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=myapp-backend
# OTEL_CONSOLE_EXPORTER=false

# Sentry — backend errors. Init is a no-op when DSN is blank.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_SEND_DEFAULT_PII=false

# Sentry — frontend errors. NEXT_PUBLIC_ prefix means it's exposed to the
# browser bundle, which is the correct posture for a DSN (public-write key).
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.0
